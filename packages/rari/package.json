{
  "name": "rari",
  "type": "module",
  "version": "0.15.17",
  "description": "Runtime Accelerated Rendering Infrastructure (rari)",
  "author": "Ryan Skinner",
  "license": "MIT",
  "homepage": "https://github.com/rari-build/rari#readme",
  "repository": {
    "directory": "packages/rari",
    "type": "git",
    "url": "git+https://github.com/rari-build/rari.git"
  },
  "bugs": {
    "url": "https://github.com/rari-build/rari/issues"
  },
  "keywords": [
    "server-components",
    "ssr",
    "vite",
    "rust",
    "deno",
    "framework",
    "solid"
  ],
  "sideEffects": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./image": {
      "types": "./src/image/index.ts",
      "default": "./src/image/index.ts"
    },
    "./font": {
      "types": "./dist/font.d.mts",
      "default": "./dist/font.mjs"
    },
    "./font/local": {
      "types": "./dist/font/local.d.mts",
      "default": "./dist/font/local.mjs"
    },
    "./font/google": {
      "types": "./dist/font/google.d.mts",
      "default": "./dist/font/google.mjs"
    },
    "./mdx": {
      "types": "./dist/mdx.d.mts",
      "default": "./dist/mdx.mjs"
    },
    "./mdx/define": {
      "types": "./dist/mdx/define.d.mts",
      "default": "./dist/mdx/define.mjs"
    },
    "./mdx/registry": {
      "types": "./dist/mdx/registry.d.mts",
      "default": "./dist/mdx/registry.mjs"
    },
    "./og": {
      "types": "./dist/og.d.mts",
      "default": "./dist/og.mjs"
    },
    "./package.json": "./package.json",
    "./router": {
      "types": "./dist/router.d.mts",
      "default": "./dist/router.mjs"
    },
    "./headers": {
      "types": "./dist/headers.d.mts",
      "default": "./dist/headers.mjs"
    },
    "./runtime/solid-call-server": {
      "types": "./dist/runtime/solid-call-server.d.mts",
      "default": "./dist/runtime/solid-call-server.mjs"
    },
    "./runtime/action-revalidation-kind": {
      "types": "./dist/runtime/action-revalidation-kind.d.mts",
      "default": "./dist/runtime/action-revalidation-kind.mjs"
    },
    "./runtime/entry-client-solid": {
      "types": "./dist/runtime/entry-client-solid.d.mts",
      "default": "./dist/runtime/entry-client-solid.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./*.mjs": "./dist/*.mjs"
  },
  "types": "dist/index.d.mts",
  "bin": {
    "rari": "./dist/cli.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src/image/constants.ts",
    "src/image/image.tsx",
    "src/image/index.ts",
    "src/image/size-plan.ts",
    "src/image/url.ts"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "pnpm typecheck && vp pack",
    "clean": "node --eval \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "tsc",
    "update-google-fonts": "node ./scripts/update-google-fonts.ts"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "catalog:mdx",
    "@rari/use-cache": "catalog:rari",
    "solid-js": "catalog:solid"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "@rari/use-cache": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/core": "catalog:solid",
    "@capsizecss/metrics": "catalog:font",
    "@capsizecss/unpack": "catalog:font",
    "babel-preset-solid": "catalog:solid",
    "seroval": "catalog:solid",
    "solid-refresh": "catalog:solid"
  },
  "optionalDependencies": {
    "rari-darwin-arm64": "0.15.17",
    "rari-darwin-x64": "0.15.17",
    "rari-linux-arm64": "0.15.17",
    "rari-linux-x64": "0.15.17",
    "rari-win32-arm64": "0.15.17",
    "rari-win32-x64": "0.15.17"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:mdx",
    "@rari/deploy": "workspace:*",
    "@rari/logger": "workspace:*",
    "@rari/use-cache": "workspace:*",
    "@types/babel__core": "catalog:solid",
    "@types/node": "catalog:typescript",
    "solid-js": "catalog:solid",
    "typescript": "catalog:typescript",
    "typescript-7": "catalog:typescript",
    "vite-plus": "catalog:build"
  }
}
